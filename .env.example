# Copiar este archivo como .env.local y completar los valores.
# .env.local no se sube al repo
# Despues de cambiarlo hay que reiniciar npm run dev.

# Google Maps (Maps JavaScript API + Places API (New))
# Pedirle la clave a un integrante del grupo. Esta restringida a http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=

# URL del backend (Spring Boot)
VITE_API_URL=http://localhost:8080
